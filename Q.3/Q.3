import matplotlib.pyplot as plt
from sklearn.datasets import load_wine
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FactorAnalysis, FastICA
wine = load_wine()
X = StandardScaler().fit_transform(wine.data)

pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)
fa = FactorAnalysis(n_components=2, random_state=42)
X_fa = fa.fit_transform(X)
ica = FastICA(
    n_components=2,
    random_state=42,
    max_iter=1000,
    whiten="unit-variance"
)
X_ica = ica.fit_transform(X)
print("Original Features:", X.shape[1])
print("PCA Output:", X_pca.shape)
print("FA Output:", X_fa.shape)
print("ICA Output:", X_ica.shape)
print("PCA Variance:", pca.explained_variance_ratio_)
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=wine.target)
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.title("PCA - Wine Dataset")
plt.show()
plt.scatter(X_fa[:, 0], X_fa[:, 1], c=wine.target)
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("Factor Analysis - Wine Dataset")
plt.show()
plt.scatter(X_ica[:, 0], X_ica[:, 1], c=wine.target)
plt.xlabel("IC1")
plt.ylabel("IC2")
plt.title("ICA - Wine Dataset")
plt.show()
